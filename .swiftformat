--swiftversion 6.2
--indent 4
--maxwidth 100
--stripunusedargs closure-only
--wraparguments before-first
--wrapparameters before-first
--extensionacl on-declarations
--exclude .build,build
# Group digits by three from four digits up — the rule SwiftLint's number_separator
# enforces — so the formatter never strips a separator the linter then demands.
--decimalgrouping 3,4
